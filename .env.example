# ─────────────────────────────────────────────────────────────────────────────
# Veyora environment configuration
# Copy to `.env` for local development. Never commit real secrets.
# Every variable is validated at startup by src/server/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
# Public base URL (used for canonical URLs, emails, payment return URLs, sitemap)
# On Vercel, leaving it unset or empty uses the deployment's own URL.
APP_URL=http://localhost:3000
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Set to true when running behind a trusted reverse proxy / platform (Vercel) so client IPs are read from X-Forwarded-For
TRUST_PROXY=false

# ── Database (PostgreSQL 15+) ───────────────────────────────────────────────
# Local: `npm run db:local` starts PostgreSQL on port 5433 with these credentials.
# Vercel: a database connected in the Storage tab (Prisma Postgres or Neon) is found automatically, including prefixed
# names such as STORAGE_POSTGRES_URL. Use a direct postgres:// URL; prisma+postgres:// Accelerate URLs are not supported.
DATABASE_URL=postgresql://veyora:veyora@localhost:5433/veyora
# Used by integration tests (the database is reset by the test setup)
TEST_DATABASE_URL=postgresql://veyora:veyora@localhost:5433/veyora_test

# ── Media storage ───────────────────────────────────────────────────────────
# local = files in STORAGE_LOCAL_DIR served from /media (not available on Vercel)
# blob  = Vercel Blob (use a public store). On Vercel, connecting the store adds BLOB_STORE_ID and the SDK
#         authenticates automatically; outside Vercel set BLOB_READ_WRITE_TOKEN from the store's settings.
# s3    = any S3-compatible store (AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=var/uploads
BLOB_READ_WRITE_TOKEN=
# Public CDN base for stored objects when STORAGE_DRIVER=s3 (e.g. https://media.veyora.com)
MEDIA_PUBLIC_BASE_URL=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Email ───────────────────────────────────────────────────────────────────
# log = write rendered emails to var/mail (development) ; smtp ; resend
EMAIL_DRIVER=log
EMAIL_FROM="Veyora <hello@localhost>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
RESEND_API_KEY=

# ── Payments ────────────────────────────────────────────────────────────────
# Comma-separated list of enabled providers, in display order: stripe, paypal, cod, sandbox
# Unset: `cod` in production, `sandbox,cod` in development.
# `sandbox` is a local test gateway (signed webhooks, no real money). It is refused when NODE_ENV=production
# unless ALLOW_SANDBOX_PAYMENTS=true (staging only).
PAYMENT_PROVIDERS=sandbox,cod
ALLOW_SANDBOX_PAYMENTS=false
SANDBOX_PAYMENTS_SECRET=

# Stripe (Checkout Sessions; Apple Pay / Google Pay are enabled in the Stripe dashboard)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (Orders v2)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ── Background jobs ─────────────────────────────────────────────────────────
# Bearer token required by GET /api/cron (Vercel Cron sends it automatically when set as CRON_SECRET)
CRON_SECRET=

# ── Rate limiting ───────────────────────────────────────────────────────────
# postgres (shared across instances) | memory (single instance / tests)
RATE_LIMIT_DRIVER=postgres

# ── Seeding ─────────────────────────────────────────────────────────────────
# First super-admin created by `npm run db:seed` (password must be 12+ chars; change it after first login)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# Load development-only demo data: 6 customers (no password, cannot sign in), orders placed through the real
# checkout and confirmed via signed sandbox webhooks, fulfilment history and approved reviews. Refused in production.
SEED_DEMO_DATA=false

# ── Catalogue import (see IMPORT_GUIDE.md) ──────────────────────────────────
# woocommerce = public WooCommerce Store API ; csv = local CSV file
IMPORT_SOURCE_TYPE=csv
IMPORT_SOURCE_URL=
IMPORT_CSV_PATH=
# Must be set to true to confirm you hold the rights to the source content.
IMPORT_AUTHORIZED=false
