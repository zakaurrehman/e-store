{
  "name": "zendropship",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zendropship — multi-category commerce platform",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:local": "tsx scripts/db/local-postgres.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx --conditions=react-server db/seed/index.ts",
    "db:studio": "prisma studio",
    "import:categories": "tsx --conditions=react-server scripts/import/cli.ts categories",
    "import:products": "tsx --conditions=react-server scripts/import/cli.ts products",
    "import:images": "tsx --conditions=react-server scripts/import/cli.ts images",
    "import:all": "tsx --conditions=react-server scripts/import/cli.ts all",
    "jobs:run": "tsx --conditions=react-server scripts/jobs/run.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/blob": "2.8.0",
    "clsx": "2.1.1",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "nodemailer": "10.0.9",
    "papaparse": "5.7.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "stripe": "22.6.2",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/nodemailer": "8.0.1",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "17.4.2",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.0"
  }
}
