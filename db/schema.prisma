enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum CouponScope {
  ORDER
  PRODUCTS
  CATEGORIES
}

model Coupon {
  id                    String             @id @default(cuid())
  /// Null for platform-wide coupons managed by Zendropship staff
  storeId               String?
  code                  String             @unique // upper-case
  description           String?
  type                  DiscountType
  /// PERCENTAGE: whole percent (1–100). FIXED_AMOUNT: cents. FREE_SHIPPING: ignored.
  value                 Int
