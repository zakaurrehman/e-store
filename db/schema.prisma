  @@index([trackingNumber])
}

model ShippingZone {
  id        String           @id @default(cuid())
  name      String
  /// ISO country codes; ["*"] = rest of world
  countries String[]
  position  Int              @default(0)
  createdAt DateTime         @default(now())
