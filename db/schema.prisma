// ─────────────────────────────────────────────────────────────────────────────
// Store wallet: what Zendropship owes each owner, and how it was settled
// ─────────────────────────────────────────────────────────────────────────────

enum WalletEntryType {
  /// What the customer paid for the goods, after discount (credit)
  ORDER_SALE
  /// Wholesale cost of the goods charged when fulfilment accepted the order (debit)
  ORDER_FULFILMENT
  /// Zendropship's commission on the sale (debit)
  ORDER_COMMISSION
  /// Reverses a sale when the order is refunded or cancelled (debit)
  ORDER_REFUND
  /// Returns the wholesale cost when a refunded or cancelled order is not fulfilled after all (credit)
  FULFILMENT_REVERSAL
  /// Returns the commission on a refunded or cancelled order (credit)
  COMMISSION_REVERSAL
  /// Net margin credited by the pre-commission ledger (before sales and costs were recorded separately)
  ORDER_EARNING
  /// Reverses an ORDER_EARNING when the order is refunded or cancelled
  ORDER_REVERSAL
  /// Money paid out to the owner (held when a withdrawal is requested)
  PAYOUT
  /// A payout that was rejected or cancelled, returned to the balance
  PAYOUT_REVERSAL
  /// Funds the owner transferred to Zendropship, credited once receipt is confirmed
  DEPOSIT
  /// Manual correction made by staff, always with a reason
  ADJUSTMENT
}

/// Whether the money behind an entry has actually been collected yet.
enum WalletEntryStatus {
  /// Recorded, but the customer's money is still in transit (cash on delivery before the parcel arrives)
  PENDING
  /// Collected: counts towards the balance the owner can withdraw
  CLEARED
}

/// Append-only ledger. The balance is the sum of its amounts; nothing else may change it.
/// An entry's status may move from PENDING to CLEARED when the money is collected — amounts never change.
model WalletEntry {
  id             String            @id @default(cuid())
  storeId        String
  type           WalletEntryType
  /// Positive credits the owner, negative debits them
  amountCents    Int
  currency       String            @default("USD")
  status         WalletEntryStatus @default(CLEARED)
  description    String
  orderId        String?
  payoutId       String?
  depositId      String?
  createdById    String?
  /// Set on postings that must happen exactly once (an order's sale, cost and commission; a deposit; a payout)
  idempotencyKey String?           @unique
  createdAt      DateTime          @default(now())
  clearedAt      DateTime?
  store          Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payout         Payout?           @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  deposit        Deposit?          @relation(fields: [depositId], references: [id], onDelete: SetNull)
  createdBy      User?             @relation("WalletEntryAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([storeId, status])
  @@index([orderId])
  @@index([type, createdAt])
}

enum PayoutStatus {
  /// The owner has asked for the money and it is held out of their available balance
  REQUESTED
  /// Staff have checked the request and are sending the money
  APPROVED
  /// Handed to the bank or provider
  PROCESSING
  PAID
  REJECTED
}

/// New withdrawals are sent in USDT on TRC20 only; the older methods stay so past payouts still read.
enum PayoutMethod {
  BANK_TRANSFER
  PAYPAL
  USDT_TRC20
}

/// A withdrawal the owner asked for. The amount leaves the balance when requested and returns if rejected.
model Payout {
  id              String           @id @default(cuid())
  storeId         String
  amountCents     Int
  status          PayoutStatus     @default(REQUESTED)
  method          PayoutMethod
  /// Where the money should go: IBAN/account details or a PayPal address, as typed by the owner
  destination     String
  note            String?
  /// Staff note or bank reference recorded when the transfer was made or refused
  reference       String?
  requestedById   String?
  processedById   String?
  processedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  requestedBy     User?            @relation("PayoutRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  processedBy     User?            @relation("PayoutProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  entries         WalletEntry[]
  supportMessages ContactMessage[]

  @@index([storeId, createdAt])
  @@index([status, createdAt])
}

/// An invitation that lets someone open a store. Codes are random and single-use unless staff raise maxUses.
model ReferralCode {
  id          String               @id @default(cuid())
  /// Shown and typed as ZD-XXXXXXXX; stored upper-case
  code        String               @unique
  /// What the code is for, e.g. a campaign or the person it was given to
  label       String?
  note        String?
  /// How many stores may be opened with it; null = unlimited (a campaign code)
  maxUses     Int?                 @default(1)
  usedCount   Int                  @default(0)
  isActive    Boolean              @default(true)
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   User?                @relation("ReferralCodeAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  redemptions ReferralRedemption[]

  @@index([isActive, createdAt])
  @@index([createdAt])
}

/// Who used a code, and the store it opened.
model ReferralRedemption {
  id        String       @id @default(cuid())
  codeId    String
  userId    String
  storeId   String?
  ipAddress String?
  createdAt DateTime     @default(now())
  code      ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  user      User         @relation("ReferralInvitee", fields: [userId], references: [id], onDelete: Cascade)
  store     Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([codeId, userId])
  @@index([userId])
  @@index([storeId])
}

enum DepositStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// USDT_TRC20 is a transfer to Zendropship's Binance USDT (TRC20) address, checked by its transaction id.
enum DepositMethod {
  BANK_TRANSFER
  CRYPTO
  USDT_TRC20
}

/// Money the owner says they have transferred to Zendropship. Credited only once staff confirm it arrived.
model Deposit {
  id              String           @id @default(cuid())
  storeId         String
  amountCents     Int
  status          DepositStatus    @default(PENDING)
  method          DepositMethod    @default(BANK_TRANSFER)
  /// Chain the owner used, e.g. "USDT (TRC20)"
  network         String?
  /// Screenshot or receipt the owner uploaded as proof, checked by staff before crediting
  proofMediaId    String?
  /// The owner's transfer reference, so staff can match it against the bank statement
  reference       String?
  note            String?
  createdById     String?
  confirmedById   String?
  confirmedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("DepositCreator", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedBy     User?            @relation("DepositConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  proof           MediaAsset?      @relation("DepositProof", fields: [proofMediaId], references: [id], onDelete: SetNull)
  entries         WalletEntry[]
  supportMessages ContactMessage[]

  @@index([storeId, createdAt])
  @@index([status, createdAt])
}
