enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

/// A support conversation: the first message plus every reply. Customers of a store reach its owner;
/// messages sent on the platform site (including an owner's own questions) reach Zendropship staff.
model ContactMessage {
  id                String         @id @default(cuid())
  /// The store the customer wrote to; null for messages sent to Zendropship itself
  storeId           String?
  /// The signed-in account that opened the conversation, when there was one
  userId            String?
  name              String
  email             String
  subject           String
  message           String
  orderNumber       String?
  /// The order the conversation is about, resolved from orderNumber when it matches
  orderId           String?
  /// The deposit or withdrawal an owner is asking about, so staff see the money beside the question
  depositId         String?
  payoutId          String?
  status            ContactStatus  @default(NEW)
  /// Staff member handling it (Zendropship inbox only)
  assignedToId      String?
  /// There is something here the inbox owner has not read
  unreadForStaff    Boolean        @default(true)
  /// There is a reply the customer has not read
  unreadForCustomer Boolean        @default(false)
  /// Newest message in the thread, for ordering the inbox
  lastMessageAt     DateTime       @default(now())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  store             Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  user              User?          @relation("SupportRequester", fields: [userId], references: [id], onDelete: SetNull)
  order             Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  deposit           Deposit?       @relation(fields: [depositId], references: [id], onDelete: SetNull)
  payout            Payout?        @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  assignedTo        User?          @relation("SupportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  replies           ContactReply[]

  @@index([status, lastMessageAt])
  @@index([storeId, lastMessageAt])
  @@index([userId, lastMessageAt])
  @@index([assignedToId, status])
  @@index([depositId])
  @@index([payoutId])
}

/// One turn in a conversation: an answer from the store or Zendropship, the customer writing back,
/// or a note staff keep to themselves (never emailed, never shown to the customer).
model ContactReply {
  id             String         @id @default(cuid())
  messageId      String
  authorId       String?
  body           String
  /// True when the customer wrote it
  isFromCustomer Boolean        @default(false)
  /// Internal note: staff-only, not emailed
  isInternal     Boolean        @default(false)
  createdAt      DateTime       @default(now())
  message        ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  author         User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([messageId, createdAt])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

