// Zendropship relational schema — PostgreSQL.
// Conventions:
//   * Money is stored as integer minor units (cents) in the store currency.
//   * Soft deletion via `deletedAt` on catalogue/customer entities that are referenced by history.
//   * Orders snapshot everything they need (names, prices, addresses) so catalogue edits never rewrite history.
// See DATABASE.md for the entity overview and indexing strategy.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity, access control & sessions
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique // SUPER_ADMIN, ADMIN, MANAGER, CUSTOMER, or custom
  name        String
  description String?
  /// Higher rank can manage lower ranks. SUPER_ADMIN=100, ADMIN=80, MANAGER=50, CUSTOMER=0.
  rank        Int              @default(0)
  isSystem    Boolean          @default(false)
  isStaff     Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. products.update
  group       String
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique // always stored lower-cased
  passwordHash        String?
  firstName           String
  lastName            String
  phone               String?
  roleId              String
  status              UserStatus           @default(ACTIVE)
  emailVerifiedAt     DateTime?
  mustResetPassword   Boolean              @default(false)
  marketingOptIn      Boolean              @default(false)
  failedLoginCount    Int                  @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  /// The store this customer signed up on (null for platform sign-ups and staff)
  registeredStoreId   String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  role                Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  store               Store?               @relation("StoreOwner")
  registeredStore     Store?               @relation("StoreSignups", fields: [registeredStoreId], references: [id], onDelete: SetNull)
  sessions            Session[]
  tokens              VerificationToken[]
  addresses           Address[]
  carts               Cart[]
  contactReplies      ContactReply[]
  supportRequests     ContactMessage[]     @relation("SupportRequester")
  supportAssignments  ContactMessage[]     @relation("SupportAssignee")
  referralCodes       ReferralCode[]       @relation("ReferralCodeAuthor")
  referralRedemptions ReferralRedemption[] @relation("ReferralInvitee")
  walletEntries       WalletEntry[]        @relation("WalletEntryAuthor")
  payoutsRequested    Payout[]             @relation("PayoutRequester")
  payoutsProcessed    Payout[]             @relation("PayoutProcessor")
  depositsCreated     Deposit[]            @relation("DepositCreator")
  depositsConfirmed   Deposit[]            @relation("DepositConfirmer")
  wishlist            Wishlist?
  orders              Order[]
  reviews             Review[]
  storeReviews        StoreReview[]
  notifications       Notification[]
  recentlyViewed      RecentlyViewed[]
  searchHistory       SearchHistory[]
  auditLogs           AuditLog[]
  orderEvents         OrderEvent[]
  mediaUploads        MediaAsset[]
  couponRedemptions   CouponRedemption[]
  couponCustomers     CouponCustomer[]
  inventoryMoves      InventoryMovement[]

  @@index([roleId])
  @@index([createdAt])
  @@index([lastName, firstName])
  @@index([registeredStoreId])
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 of the opaque token stored in the httpOnly cookie. The raw token is never persisted.
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model Address {
  id                String    @id @default(cuid())
  userId            String
  label             String?
  firstName         String
  lastName          String
  company           String?
  line1             String
  line2             String?
  city              String
  region            String?
  postalCode        String
  country           String // ISO 3166-1 alpha-2
  phone             String?
  isDefaultShipping Boolean   @default(false)
  isDefaultBilling  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Media
// ─────────────────────────────────────────────────────────────────────────────

model MediaAsset {
  id            String           @id @default(cuid())
  /// Storage key of the optimised master (e.g. products/2026/09/abc.webp)
  storageKey    String           @unique
  url           String
  filename      String
  mimeType      String
  sizeBytes     Int
  width         Int?
  height        Int?
  alt           String           @default("")
  /// Optional attribution / licence line (e.g. "Photo by … on Unsplash")
  credit        String?
  folder        String           @default("library")
  checksum      String?
  uploadedById  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?
  uploadedBy    User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  productImages ProductImage[]
  variants      ProductVariant[]
  categories    Category[]
  brands        Brand[]
  collections   Collection[]
  banners       Banner[]         @relation("BannerImage")
  mobileBanners Banner[]         @relation("BannerMobileImage")
  reviewImages  ReviewImage[]
  depositProofs Deposit[]        @relation("DepositProof")
  storeLogos    Store[]          @relation("StoreLogo")
  storeHeroes   Store[]          @relation("StoreHero")

  @@index([folder, createdAt])
  @@index([checksum])
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalogue
// ─────────────────────────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AttributeType {
  SELECT
  COLOR
  TEXT
}

enum CollectionRule {
  MANUAL
  NEW_ARRIVALS
  ON_SALE
  BEST_SELLERS
  TOP_RATED
  FEATURED
}

model Category {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  description    String?
  parentId       String?
  imageId        String?
  position       Int               @default(0)
  isActive       Boolean           @default(true)
  showInNav      Boolean           @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  parent         Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]        @relation("CategoryTree")
  image          MediaAsset?       @relation(fields: [imageId], references: [id], onDelete: SetNull)
  products       ProductCategory[]
  primaryFor     Product[]         @relation("PrimaryCategory")
  coupons        CouponCategory[]

  @@index([parentId, position])
}

model Brand {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  description    String?
  story          String?
  logoId         String?
  website        String?
  position       Int         @default(0)
  isActive       Boolean     @default(true)
  isFeatured     Boolean     @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  logo           MediaAsset? @relation(fields: [logoId], references: [id], onDelete: SetNull)
  products       Product[]

  @@index([position])
}

model Collection {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  description    String?
  imageId        String?
  rule           CollectionRule      @default(MANUAL)
  position       Int                 @default(0)
  isActive       Boolean             @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?
  image          MediaAsset?         @relation(fields: [imageId], references: [id], onDelete: SetNull)
  products       CollectionProduct[]

  @@index([position])
}

model Tag {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now())
  products  ProductTag[]
}

model Attribute {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  type            AttributeType    @default(SELECT)
  /// Values of this attribute can define purchasable variants (e.g. Size, Colour)
  isVariantOption Boolean          @default(true)
  isFilterable    Boolean          @default(true)
  position        Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  values          AttributeValue[]
}

model AttributeValue {
  id            String                  @id @default(cuid())
  attributeId   String
  value         String
  slug          String
  colorHex      String?
  position      Int                     @default(0)
  attribute     Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantValues VariantOptionValue[]
  productValues ProductAttributeValue[]

  @@unique([attributeId, slug])
  @@index([attributeId, position])
}

model Product {
  id                  String                  @id @default(cuid())
  name                String
  slug                String                  @unique
  shortDescription    String?
  /// Markdown
  description         String?
  status              ProductStatus           @default(DRAFT)
  brandId             String?
  primaryCategoryId   String?
  isFeatured          Boolean                 @default(false)
  /// [{ label, value }] rendered as the specifications table
  specifications      Json                    @default("[]")
  careInstructions    String?
  shippingNote        String?
  seoTitle            String?
  seoDescription      String?
  publishedAt         DateTime?
  // Denormalised read model, maintained by the catalogue service on every write.
  priceCents          Int                     @default(0)
  maxPriceCents       Int                     @default(0)
  compareAtPriceCents Int?
  onSale              Boolean                 @default(false)
  inStock             Boolean                 @default(false)
  totalStock          Int                     @default(0)
  ratingAverage       Float                   @default(0)
  ratingCount         Int                     @default(0)
  salesCount          Int                     @default(0)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  deletedAt           DateTime?
  brand               Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  primaryCategory     Category?               @relation("PrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  categories          ProductCategory[]
  collections         CollectionProduct[]
  tags                ProductTag[]
  images              ProductImage[]
  variants            ProductVariant[]
  attributeValues     ProductAttributeValue[]
  reviews             Review[]
  wishlistItems       WishlistItem[]
  orderItems          OrderItem[]
  recentlyViewed      RecentlyViewed[]
  searchDocument      SearchDocument?
  coupons             CouponProduct[]
  storeProducts       StoreProduct[]

  @@index([status, deletedAt, publishedAt])
  @@index([brandId])
  @@index([primaryCategoryId])
  @@index([priceCents])
  @@index([salesCount])
  @@index([ratingAverage])
  @@index([createdAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model ProductImage {
  id        String     @id @default(cuid())
  productId String
  mediaId   String
  position  Int        @default(0)
  alt       String?
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaId])
  @@index([productId, position])
}

/// Every product has at least one variant; simple products have a single default variant.
model ProductVariant {
  id                String               @id @default(cuid())
  productId         String
  sku               String?              @unique
  barcode           String?
  title             String               @default("Default")
  priceCents        Int
  salePriceCents    Int?
  costCents         Int?
  stockQuantity     Int                  @default(0)
  lowStockThreshold Int                  @default(5)
  trackInventory    Boolean              @default(true)
  allowBackorder    Boolean              @default(false)
  weightGrams       Int?
  lengthMm          Int?
  widthMm           Int?
  heightMm          Int?
  imageId           String?
  position          Int                  @default(0)
  isDefault         Boolean              @default(false)
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  product           Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  image             MediaAsset?          @relation(fields: [imageId], references: [id], onDelete: SetNull)
  options           VariantOptionValue[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  inventoryMoves    InventoryMovement[]

  @@index([productId, position])
  @@index([stockQuantity])
}

model VariantOptionValue {
  variantId        String
  attributeValueId String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
}

/// Non-variant, filterable facts (e.g. Material: Leather)
model ProductAttributeValue {
  productId        String
  attributeValueId String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productId, attributeValueId])
  @@index([attributeValueId])
}

enum InventoryReason {
  INITIAL
  ADJUSTMENT
  RESTOCK
  ORDER_PLACED
  ORDER_CANCELLED
  RETURN
  IMPORT
  BULK_UPDATE
}

/// Append-only inventory ledger. ProductVariant.stockQuantity is the running balance.
model InventoryMovement {
  id           String          @id @default(cuid())
  variantId    String
  delta        Int
  balanceAfter Int
  reason       InventoryReason
  note         String?
  orderId      String?
  actorId      String?
  createdAt    DateTime        @default(now())
  variant      ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order        Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor        User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Search
// ─────────────────────────────────────────────────────────────────────────────

/// Postgres search read model (full-text + trigram). Swappable for Meilisearch/Algolia via SearchProvider.
model SearchDocument {
  productId String                   @id
  title     String
  content   String
  vector    Unsupported("tsvector")?
  updatedAt DateTime                 @updatedAt
  product   Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([vector], type: Gin, map: "SearchDocument_vector_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "SearchDocument_title_trgm_idx")
}

model SearchQuery {
  term            String   @id // normalised (lower-case, trimmed)
  count           Int      @default(1)
  lastResultCount Int      @default(0)
  lastSearchedAt  DateTime @default(now())

  @@index([count])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  term      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, term])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cart & wishlist
// ─────────────────────────────────────────────────────────────────────────────

enum StoreStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum StorePricingMode {
  /// Sell at the supplier's suggested retail price (sale prices included)
  SUGGESTED
  /// Wholesale cost plus the store's markup
  MARKUP
}

/// A dropshipper's store: its own subdomain, branding, product selection and orders.
/// Products, stock, shipping and fulfilment come from the platform catalogue.
model Store {
  id                String               @id @default(cuid())
  /// Subdomain: <slug>.zendropship.io — lower-case letters, digits and hyphens
  slug              String               @unique
  name              String
  ownerId           String?              @unique
  /// Who owned a store staff have deleted. The owner link itself is released, so they can open another.
  formerOwnerId     String?
  status            StoreStatus          @default(ACTIVE)
  pricingMode       StorePricingMode     @default(SUGGESTED)
  /// Markup over wholesale in basis points (4000 = 40%) when pricingMode is MARKUP
  markupBps         Int                  @default(4000)
  currency          String               @default("USD")
  tagline           String?
  aboutText         String?
  supportEmail      String?
  announcement      String?
  logoId            String?
  heroImageId       String?
  heroTitle         String?
  heroSubtitle      String?
  /// Accent colour as #rrggbb
  accentColor       String               @default("#5446ff")
  /// Owner's own domain (verified separately); null until connected
  customDomain      String?              @unique
  /// Stripe Connect account id once the owner has started onboarding
  stripeAccountId   String?              @unique
  stripeOnboardedAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?
  owner             User?                @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  logo              MediaAsset?          @relation("StoreLogo", fields: [logoId], references: [id], onDelete: SetNull)
  heroImage         MediaAsset?          @relation("StoreHero", fields: [heroImageId], references: [id], onDelete: SetNull)
  products          StoreProduct[]
  orders            Order[]
  carts             Cart[]
  coupons           Coupon[]
  messages          ContactMessage[]
  walletEntries     WalletEntry[]
  payouts           Payout[]
  deposits          Deposit[]
  referral          ReferralRedemption[]
  signups           User[]               @relation("StoreSignups")
  reviews           StoreReview[]

  @@index([status])
  @@index([createdAt])
}

/// A platform product listed in a store, with the owner's pricing.
model StoreProduct {
  id              String   @id @default(cuid())
  storeId         String
  productId       String
  isActive        Boolean  @default(true)
  /// Overrides the store's markup for this product (basis points)
  markupBps       Int?
  /// Fixed retail price for every variant of this product, overriding markup and suggested pricing
  fixedPriceCents Int?
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([productId])
  @@index([storeId, isActive, position])
}

model Cart {
  id         String     @id @default(cuid())
  storeId    String
  userId     String?
  /// SHA-256 of the guest cart cookie token
  tokenHash  String?    @unique
  couponCode String?
  email      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  expiresAt  DateTime?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@unique([userId, storeId])
  @@index([updatedAt])
  @@index([storeId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([productId])
}

model RecentlyViewed {
  userId    String
  productId String
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, viewedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders, payments, fulfilment
// ─────────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  /// Placed, waiting for the customer's online payment
  PENDING
  /// The customer's payment is in (or cash on delivery is agreed)
  CONFIRMED
  /// Fulfilment needs money the owner's balance cannot cover yet
  AWAITING_FUNDS
  /// Funded and taken by Zendropship fulfilment; the wholesale cost has been charged to the owner
  ACCEPTED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum OrderEventType {
  CREATED
  STATUS_CHANGED
  PAYMENT
  SHIPMENT
  REFUND
  NOTE
  EMAIL
  SYSTEM
}

model Order {
  id                  String              @id @default(cuid())
  number              String              @unique
  storeId             String
  userId              String?
  email               String
  phone               String?
  status              OrderStatus         @default(PENDING)
  paymentStatus       PaymentStatus       @default(PENDING)
  paymentProvider     String
  currency            String
  subtotalCents       Int
  discountCents       Int                 @default(0)
  shippingCents       Int                 @default(0)
  taxCents            Int                 @default(0)
  totalCents          Int
  refundedCents       Int                 @default(0)
  /// Wholesale cost of the goods, charged to the owner's balance when fulfilment accepts the order
  fulfilmentCostCents Int                 @default(0)
  /// Zendropship's commission rate at the time of the order (basis points) — historical orders never recalculate
  commissionRateBps   Int                 @default(0)
  /// What that rate was applied to: ORDER_REVENUE (goods sold, after discount) or OWNER_MARGIN
  commissionBase      String              @default("ORDER_REVENUE")
  commissionCents     Int                 @default(0)
  /// Goods sold (after discount) less wholesale cost less commission
  ownerEarningCents   Int                 @default(0)
  couponCode          String?
  /// Address snapshots — immune to later address-book edits
  shippingAddress     Json
  billingAddress      Json
  shippingMethodId    String?
  shippingMethodName  String
  customerNote        String?
  /// Prevents duplicate orders from double submits / retries
  idempotencyKey      String              @unique
  /// SHA-256 of the token that lets a guest view this order
  accessTokenHash     String?
  inventoryReleased   Boolean             @default(false)
  placedAt            DateTime            @default(now())
  paidAt              DateTime?
  /// When fulfilment took the order (and the owner's balance was charged)
  acceptedAt          DateTime?
  cancelledAt         DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  user                User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  store               Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  shippingMethod      ShippingMethod?     @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  events              OrderEvent[]
  payments            Payment[]
  shipments           Shipment[]
  couponRedemption    CouponRedemption?
  inventoryMoves      InventoryMovement[]
  walletEntries       WalletEntry[]
  supportMessages     ContactMessage[]
  storeReview         StoreReview?

  @@index([userId, createdAt])
  @@index([storeId, status])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([email])
  @@index([createdAt])
  @@index([storeId, createdAt])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  productId      String?
  variantId      String?
  productName    String
  productSlug    String
  variantTitle   String?
  sku            String?
  imageUrl       String?
  unitPriceCents Int
  /// Wholesale cost per unit charged to the store owner (snapshot)
  unitCostCents  Int             @default(0)
  quantity       Int
  discountCents  Int             @default(0)
  taxCents       Int             @default(0)
  totalCents     Int
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  review         Review?

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderEvent {
  id         String         @id @default(cuid())
  orderId    String
  type       OrderEventType
  message    String
  data       Json?
  isInternal Boolean        @default(false)
  actorId    String?
  createdAt  DateTime       @default(now())
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor      User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model Payment {
  id                String               @id @default(cuid())
  orderId           String
  provider          String
  /// Provider reference (Checkout Session id, PayPal order id, sandbox id…)
  providerReference String?
  status            PaymentStatus        @default(PENDING)
  amountCents       Int
  currency          String
  capturedCents     Int                  @default(0)
  refundedCents     Int                  @default(0)
  failureReason     String?
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions      PaymentTransaction[]

  @@unique([provider, providerReference])
  @@index([orderId])
  @@index([status])
}

enum TransactionType {
  AUTHORIZATION
  CAPTURE
  CHARGE
  REFUND
  VOID
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model PaymentTransaction {
  id                    String            @id @default(cuid())
  paymentId             String
  type                  TransactionType
  status                TransactionStatus
  amountCents           Int
  providerTransactionId String?
  reason                String?
  raw                   Json?
  actorId               String?
  createdAt             DateTime          @default(now())
  payment               Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([providerTransactionId])
}

/// Every inbound webhook is recorded once; (provider, eventId) makes processing idempotent.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([createdAt])
}

enum ShipmentStatus {
  PENDING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  status         ShipmentStatus @default(PENDING)
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
